# docker-mailserver 환경설정 (핵심 보안 기능 활성화)
# 참고: 전체 옵션은 docker-mailserver 공식 mailserver.env 참조. 아래는 피싱/사칭 방어 핵심만.

# ----- 일반 -----
OVERRIDE_HOSTNAME=mail.bank.lab
POSTMASTER_ADDRESS=postmaster@bank.lab
LOG_LEVEL=info
PERMIT_DOCKER=connected-networks

# ----- 안티스팸/피싱: Rspamd 사용 (Amavis/SA 대체) -----
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_LEARN=1
MOVE_SPAM_TO_JUNK=1
SPAM_SUBJECT=[의심메일]

# ----- 안티바이러스 -----
ENABLE_CLAMAV=1          # 첨부 스캔 (EICAR 포함 탐지)

# ----- 메일 인증: SPF / DKIM / DMARC -----
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1     # 수신 SPF 검증
# DMARC 실패 정책은 OpenDMARC + Rspamd dmarc 모듈로 처리 (reject/quarantine)

# ----- 무차별 대입 방어 -----
ENABLE_FAIL2BAN=1

# ----- TLS (랩: 자체서명) -----
SSL_TYPE=self-signed

# ----- 계정은 config/postfix-accounts.cf 로 관리 (setup-notes 참조) -----
